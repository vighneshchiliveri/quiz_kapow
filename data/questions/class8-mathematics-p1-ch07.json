    {
      "q": "In direct proportion, when one quantity increases, the other ____.",
      "options": [
        "decreases",
        "increases in the same ratio",
        "becomes zero",
        "stays the same"
      ],
      "answer": 1,
      "explanation": "Direct proportion means both change by the same factor."
